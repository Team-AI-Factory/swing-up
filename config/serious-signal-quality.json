  "livePollingIntervalSeconds": 300,
  "technicalFailureRetrySeconds": 60,
  "minimumInputCompleteness": 100,
  "minimumIndependentReceipts": 2,
  "minimumProfitPotentialScore": 60,
  "minimumEvidenceConfidenceScore": 60,
  "requireLiveInputProvenance": true,
  "requireLivePriceAtAlert": true,
  "allowMockFallback": false,
  "allowNeutralFallback": false,
