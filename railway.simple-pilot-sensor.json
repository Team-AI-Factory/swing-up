{
  "$schema": "https://railway.com/railway.schema.json",
  "build": { "builder": "RAILPACK", "buildCommand": "npm run build" },
  "deploy": { "startCommand": "node scripts/simple-alert-pilot-cycle.mjs", "cronSchedule": "*/15 * * * *", "restartPolicyType": "NEVER" },
  "environments": { "pr": { "deploy": { "startCommand": "node scripts/simple-alert-paused.mjs", "cronSchedule": null, "restartPolicyType": "NEVER" } } }
}
