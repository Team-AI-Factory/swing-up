{
  "$schema": "https://railway.com/railway.schema.json",
  "build": {
    "builder": "RAILPACK"
  },
  "deploy": {
    "startCommand": "npm run pr262:cron",
    "cronSchedule": "*/15 * * * *",
    "restartPolicyType": "NEVER"
  },
  "environments": {
    "pr": {
      "build": {
        "buildCommand": "npm run build"
      },
      "deploy": {
        "startCommand": "node scripts/railway-preview-start.mjs",
        "preDeployCommand": [],
        "cronSchedule": null,
        "restartPolicyType": "NEVER"
      }
    }
  }
}
