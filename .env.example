DATABASE_URL="postgresql://USER:PASSWORD@HOST:PORT/DATABASE"
SEC_USER_AGENT="SwingUp/0.1 research-contact@example.com"
EAR_RUN_TOKEN=""
BENZINGA_API_KEY=""

# Keep each internal credential different. Never reuse the cheap sensor token
# for analysis, publishing, notification-feed reads, or the local cron call.
SWING_UP_INTERNAL_API_TOKEN=""
SWING_UP_AUTOMATION_TOKEN=""
SWING_UP_PR262_CRON_RUNTIME_TOKEN=""
SWING_UP_PR262_SENSOR_TOKEN=""
SWING_UP_PR262_FOUNDATION_RUNTIME_TOKEN=""
SWING_UP_PR262_HANDOFF_SECRET=""
SWING_UP_SERIOUS_SIGNAL_READ_TOKEN=""
SWING_UP_PR262_PRODUCTION_FOUNDATION_ENABLED="false"
SWING_UP_PR262_SENSOR_OWNER="railway"
SWING_UP_PR262_PREMERGE_PRODUCTION_ROLLOUT="false"
SWING_UP_PR262_PREMERGE_APPROVED_COMMIT_SHA=""
SWING_UP_PR262_PROJECTED_RAILWAY_MONTHLY_COST_USD=""

# Production PR262 code requires the first value to be production/pr262/.
# Set the generic write guard to that same prefix only on the isolated sensor,
# recovery, and foundation services. Leave the persistent web service's
# existing global R2 write policy unchanged so non-PR262 app writes still work.
SWING_UP_PR262_STORAGE_PREFIX=""
SWING_UP_R2_WRITE_PREFIX=""

# Serious Signal delivery: configure at least one live channel in production.
TELEGRAM_BOT_TOKEN=""
TELEGRAM_SERIOUS_SIGNAL_CHAT_ID=""
SWING_UP_SERIOUS_SIGNAL_WEBHOOK_URL=""
SWING_UP_SERIOUS_SIGNAL_DELIVERY_MAX_ATTEMPTS="8"
SWING_UP_SERIOUS_SIGNAL_DELIVERY_MAX_AGE_MINUTES="30"
SWING_UP_PR262_AI_DAILY_LIMIT_USD="10"
SWING_UP_PR262_AI_DAILY_WARNING_USD="6"
SWING_UP_PR262_AI_REVIEW_RESERVATION_USD="0.75"
SWING_UP_PR262_AI_UNKNOWN_USAGE_FALLBACK_USD="0.75"
OPENAI_MODEL="gpt-4.1-mini-2025-04-14"
AI_COMMITTEE_FAST_MODEL="gpt-4.1-mini-2025-04-14"
AI_COMMITTEE_DEEP_MODEL="gpt-4.1-mini-2025-04-14"
AI_COMMITTEE_FINAL_MODEL="gpt-4.1-mini-2025-04-14"
AI_COMMITTEE_MODEL_ALLOWLIST="gpt-4.1-mini-2025-04-14"
